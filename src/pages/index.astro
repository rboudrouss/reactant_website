  {/* The sources the live runs read back. In the markup once, here as data
      once: the panes are what the visitor edits, this is where a reset returns. */}
  <script is:inline type="application/json" id="cross-file-data" set:html={JSON.stringify(crossFiles)} />
  <script is:inline type="application/json" id="demo-data" set:html={JSON.stringify(demos)} />

  {/* Inline and separate from the module below: that one loads the
      WebAssembly analyzer, and a failure there must not take the copy buttons
      down with it. */}
  <script is:inline>
    (() => {
      for (const button of document.querySelectorAll(".copy")) {
        button.hidden = false;
        let revert;
        button.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy);
          } catch {
            // Clipboard refused: select the command instead, it is one click away anyway.
            const code = button.closest(".cmd").querySelector("code");
            const range = document.createRange();
            range.selectNodeContents(code);
            const selection = window.getSelection();
            selection.removeAllRanges();
            selection.addRange(range);
            return;
          }
          button.textContent = "copied";
          clearTimeout(revert);
          revert = setTimeout(() => {
            button.textContent = "copy";
          }, 1600);
        });
      }
    })();
  </script>

  <script>
    import { initWasm, run, UsageError } from "reactant-analyzer/browser";
    // Vite emits the `.wasm` as an asset and hands back its final URL. Without
    // this the glue fetches the bytes next to itself, which is the source path in
    // dev and a hashed chunk with no `.wasm` beside it in a build. The specifier
    // is an alias onto the file in node_modules, defined in astro.config.mjs
    // because the package's `exports` map does not expose it.
    import wasmUrl from "reactant-analyzer/wasm-binary?url";
    import { ansiToHtml } from "../lib/ansi";
    import { highlight } from "../lib/highlight";
    import { annotate } from "../lib/annotate";

    type Source = { id: string; path: string; source: string };

    const crossFiles: Source[] = JSON.parse(
      document.getElementById("cross-file-data")!.textContent!,
    );

    // ── panes ─────────────────────────────────────────────────────────────────

    type Pane = {
      /** What is in the box, which is not the pristine source once edited. */
      read: () => string;
      /** Put text in the box and repaint; used by Reset. */
      load: (text: string) => void;
    };

    /**
     * Wire one editable pane: the highlighted layer under the caret, the box
     * that grows with its content, and a callback for every keystroke.
     */
    function mountPane(wrap: HTMLElement, onInput: () => void): Pane {
      const hl = wrap.querySelector(".hl") as HTMLPreElement;
      const editor = wrap.querySelector(".editor") as HTMLTextAreaElement;

      /** Keep the painted copy at the same offset as the text over it. */
      const sync = () => {
        hl.scrollLeft = editor.scrollLeft;
        hl.scrollTop = editor.scrollTop;
      };

      /** Grow the box to its content: a scrollbar on ten lines of code reads badly. */
      const refresh = () => {
        editor.rows = editor.value.split("\n").length;
        hl.innerHTML = highlight(editor.value);
        sync();
      };

      editor.addEventListener("input", () => {
        refresh();
        onInput();
      });
      editor.addEventListener("scroll", sync);

      refresh();
      // The layer only takes over once it holds something to show.
      wrap.classList.add("lit");

      return {
        read: () => editor.value,
        load(text) {
          editor.value = text;
          refresh();
        },
      };
    }

    // ── the runs ──────────────────────────────────────────────────────────────

    // One WebAssembly instance, and the analysis cannot be reentered, so every
    // run on the page goes through this one chain: the hero pair and the
    // example below take turns rather than collide.
    let chain: Promise<unknown> = Promise.resolve();

    function exclusive<T>(job: () => Promise<T>): Promise<T> {
      const next = chain.then(job, job);
      chain = next.catch(() => {});
      return next;
    }

    type RunOptions = { trace?: boolean; showClean?: boolean };

    /**
     * An analyze-and-print loop for one output block. `collect` is read at the
     * last moment, so a run always reports on what is in the boxes when it
     * starts; `post` gets the last word on the HTML (the example adds its
     * marks there).
     */
    function runner(
      out: HTMLPreElement,
      collect: () => Record<string, string>,
      options: RunOptions,
      post: (html: string) => string = (html) => html,
    ) {
      let running = false;
      /** A run asked for while one was in flight: the inputs moved under it. */
      let again = false;

      async function analyze(): Promise<void> {
        if (running) {
          again = true;
          return;
        }
        running = true;
        out.ariaBusy = "true";

        // The analysis holds the thread for its duration, so yield once and let
        // the browser paint before it starts.
        await new Promise((resolve) => requestAnimationFrame(resolve));

        try {
          const { stdout, stderr } = await exclusive(() =>
            run({ files: collect(), format: "human", color: true, ...options }),
          );
          out.innerHTML = post(ansiToHtml((stdout + stderr).trimEnd())) || "(no output)";
        } catch (error) {
          // A finding is a result; only a usage error throws. Anything else is
          // this page's own fault and should read like it.
          const prefix = error instanceof UsageError ? "usage error" : "demo error";
          out.innerHTML = `<span class="red">${prefix}:</span> ${
            error instanceof Error ? error.message : String(error)
          }`;
        } finally {
          out.ariaBusy = "false";
          running = false;
        }

        // Whatever changed mid-run is in the inputs now, so honour it.
        if (again) {
          again = false;
          await analyze();
        }
      }

      return analyze;
    }

    // Typing re-runs on its own: a run is a couple of milliseconds, and a Run
    // button is one more thing to explain.
    function debounced(analyze: () => void): () => void {
      let timer: number | undefined;
      return () => {
        window.clearTimeout(timer);
        timer = window.setTimeout(analyze, 400);
      };
    }

    // ── the hero: two files, one run ──────────────────────────────────────────

    const pair = document.getElementById("pair") as HTMLDivElement;
    const panes = new Map<string, Pane>();

    // Every run reports on both files, whichever one was typed in: the bug is
    // the pair, and a file checked alone is the reading this page argues
    // against. The same options as the build-time run, so nothing shifts when
    // the script takes over: `showClean` is what ticks `Dashboard`.
    const pairAnalyze = runner(
      document.getElementById("xfile-out") as HTMLPreElement,
      () =>
        Object.fromEntries(
          crossFiles.map((file) => [file.path, panes.get(file.id)!.read()]),
        ),
      { showClean: true },
    );
    const onPairInput = debounced(pairAnalyze);

    const pristine = () =>
      crossFiles.every((file) => panes.get(file.id)!.read() === file.source);

    for (const file of crossFiles) {
      const wrap = document.querySelector(`[data-xfile="${file.id}"]`) as HTMLDivElement;
      const reset = document.querySelector(`[data-xfile-reset="${file.id}"]`) as HTMLButtonElement;

      const pane: Pane = mountPane(wrap, () => {
        // Shown on the keystroke, not on the run 400ms later: the button has to
        // answer the edit that put it there. The wire between the panes is
        // drawn on row 5 of the pristine sources, so the first edit takes it
        // down; a reset of both files brings it back.
        reset.hidden = pane.read() === file.source;
        pair.classList.toggle("wired", pristine());
        onPairInput();
      });
      panes.set(file.id, pane);

      reset.addEventListener("click", () => {
        pane.load(file.source);
        reset.hidden = true;
        pair.classList.toggle("wired", pristine());
        pairAnalyze();
      });
    }

    // ── the example: one file, six shapes ─────────────────────────────────────

    type Demo = Source & { label: string };
    const demos: Demo[] = JSON.parse(document.getElementById("demo-data")!.textContent!);

    const picker = document.querySelector(".picker") as HTMLUListElement;
    const pathLabel = document.getElementById("demo-path") as HTMLElement;
    const cmdPath = document.getElementById("demo-cmd-path") as HTMLElement;
    const demoReset = document.getElementById("demo-reset") as HTMLButtonElement;

    /** The visitor's edits, per example; `demos` keeps the pristine text. */
    const edited = new Map<string, string>();
    let current = demos[0];
    const sourceOf = (demo: Demo) => edited.get(demo.id) ?? demo.source;

    const demoAnalyze = runner(
      document.getElementById("demo-out") as HTMLPreElement,
      () => {
        // Remember the edit before reporting on it, so leaving the example and
        // coming back shows the same text.
        if (demoPane.read() !== current.source) edited.set(current.id, demoPane.read());
        return { [current.path]: demoPane.read() };
      },
      { trace: true, showClean: true },
      // The marks the notes point at, re-placed on every run since the output
      // is rebuilt from scratch each time.
      annotate,
    );

    const demoPane = mountPane(document.getElementById("demo-wrap") as HTMLDivElement, () => {
      demoReset.hidden = demoPane.read() === current.source;
      debouncedDemo();
    });
    const debouncedDemo = debounced(demoAnalyze);

    function select(demo: Demo) {
      current = demo;
      pathLabel.textContent = demo.path;
      cmdPath.textContent = demo.path;
      demoPane.load(sourceOf(demo));
      demoReset.hidden = !edited.has(demo.id);
      for (const button of picker.querySelectorAll<HTMLButtonElement>(".pick")) {
        button.ariaSelected = String(button.dataset.demo === demo.id);
      }
    }

    for (const button of picker.querySelectorAll<HTMLButtonElement>(".pick")) {
      button.addEventListener("click", () => {
        const demo = demos.find((d) => d.id === button.dataset.demo);
        if (!demo || demo === current) return;
        // Keep the edit that is in the box before leaving it behind.
        if (demoPane.read() !== current.source) edited.set(current.id, demoPane.read());
        select(demo);
        demoAnalyze();
      });
    }

    demoReset.addEventListener("click", () => {
      edited.delete(current.id);
      demoPane.load(current.source);
      demoReset.hidden = true;
      demoAnalyze();
    });

    // ── start ─────────────────────────────────────────────────────────────────

    // Instantiate up front, so the first run is as quick as the rest and a
    // failed fetch surfaces here rather than as a box that never fills in. Both
    // output blocks already hold the build-time run of the sources they show,
    // so they are left alone until the visitor edits or picks something; the
    // tabs only appear once there is an analyzer to answer them.
    initWasm(wasmUrl).then(
      () => {
        picker.hidden = false;
      },
      (error: unknown) => {
        // The build-time outputs are still true; only the re-running stops.
        console.error("could not load the analyzer:", error);
      },
    );
  </script>
</Base>

