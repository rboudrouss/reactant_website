    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--surface);
    padding: 0.7rem 0.9rem;
  }

  .stat dt {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text);
  }

  .stat dd {
    margin-top: 0.15rem;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--text-muted);
  }

  .stats-note {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  @media (max-width: 700px) {
    .stats {
      grid-template-columns: 1fr;
    }
  }

  /* ── sections ── */
  .section {
    padding-block: 1.75rem;
  }

  .section > .container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .section-title {
    font-size: 1.35rem;
    font-weight: 700;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--accent-light);
  }

  /* One band, so the page is not a single uninterrupted column. A deeper
     tone of the same beige, not a switch to white: white reads as a
     different material rather than a section. */
  .band {
    background: var(--band);
    border-block: 1px solid var(--border);
    padding-block: 3.25rem;
  }

  .note {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .muted {
    color: var(--text-muted);
  }

  /* ── example ── */
  .code-pair {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .callout {
    border-left: 3px solid var(--bad-fg);
    background: var(--bad-bg);
    border-radius: 0 0.375rem 0.375rem 0;
    padding: 0.9rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .callout p {
    font-size: 0.9rem;
    line-height: 1.7;
  }

  /* The same box without the red: this one answers an objection, it does not
     report a bug. */
  .callout-neutral {
    border-left-color: var(--accent);
    background: var(--accent-subtle);
  }

  .callout code {
    background: var(--code-bg);
    border-color: transparent;
  }

  /* ── rules ── */
  .families {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem 2.5rem;
    margin-top: 0.5rem;
  }

  .family-label {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .family-note {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.6rem;
    line-height: 1.6;
  }

  .rule-list {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-top: 0.8rem;
  }

  .rule dt code {
    font-size: 0.78rem;
    color: var(--accent);
    background: var(--accent-subtle);
    border-color: transparent;
    white-space: nowrap;
  }

  .rule dd {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-top: 0.2rem;
  }

  /* ── comparison ── */
  /* ── comparison ── */
  /* The three roles come before the table, and read as three cards rather
     than three columns: the section's point is that they run together. */
  /* The four lines of a card (name, moment, what it does, where it stops) sit
     on shared rows, so the three cards line up line for line however long each
     one's text runs. `row-gap` is the space inside a card, `column-gap` the
     space between them. */
  .roles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 0.75rem;
    row-gap: 0.4rem;
    margin-top: 0.5rem;
  }

  .role {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 4;
    gap: 0.4rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--surface);
    padding: 0.9rem 1rem;
  }

  .role-name {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .role-when {
    font-size: 0.75rem;
    color: var(--accent);
    font-weight: 600;
  }

  /* The cost sits on the same line as the moment it runs: the two together are
     why each tool lives where it does. */
  .role-cost {
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--text-muted);
  }

  .role-cost::before {
    content: "· ";
  }

  .role-for,
  .role-limit {
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .role-limit {
    color: var(--text-muted);
    padding-top: 0.15rem;
  }

  .table-title {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: 1.25rem;
  }

  /* Stacked, the rows have nothing to line up with, and sharing them would
     squeeze the gap between cards down to the gap inside one. */
  @media (max-width: 820px) {
    .roles {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .role {
      display: flex;
      flex-direction: column;
    }
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--bg);
    margin-top: 0.5rem;
  }

  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.85rem;
  }

  thead th {
    text-align: left;
    padding: 0.65rem 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    white-space: nowrap;
    border-bottom: 1px solid var(--border);
  }

  tbody th {
    text-align: left;
    font-weight: 500;
    color: var(--text);
  }

  tbody th,
  tbody td {
    padding: 0.5rem 0.9rem;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: none;
  }

  .chip {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border-radius: 0.25rem;
  }

  .chip.ok {
    color: var(--ok-fg);
    background: var(--ok-bg);
  }

  .chip.warn {
    color: var(--warn-fg);
    background: var(--warn-bg);
  }

  .chip.bad {
    color: var(--bad-fg);
    background: var(--bad-bg);
  }

  .chip.none {
    color: var(--text-muted);
    background: var(--code-bg);
  }

  /* Narrow screens: the matrix becomes one card per bug class, so the
     reactant column is never the one pushed off the side. */
  @media (max-width: 700px) {
    .table-wrap {
      overflow-x: visible;
      border: none;
      background: none;
    }

    table,
    tbody,
    tbody tr,
    tbody th,
    tbody td {
      display: block;
    }

    thead {
      display: none;
    }

    tbody tr {
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      background: var(--bg);
      padding: 0.75rem 0.9rem;
      margin-bottom: 0.6rem;
    }

    tbody tr:last-child {
      margin-bottom: 0;
    }

    tbody th {
      padding: 0 0 0.6rem;
      border-bottom: 1px solid var(--border);
      margin-bottom: 0.5rem;
      white-space: normal;
      font-weight: 600;
    }

    tbody td {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.2rem 0;
      border: none;
    }

    tbody td::before {
      content: attr(data-tool);
      font-size: 0.72rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
  }

  .notes {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-top: 0.5rem;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .notes li {
    padding-left: 1rem;
    position: relative;
  }

  .notes li::before {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--accent-light);
  }

  /* ── docs ── */
  .doc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.9rem;
  }

  .doc-list li {
    padding-left: 1rem;
    position: relative;
  }

  .doc-list li::before {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--accent-light);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }

  .tag {
    font-size: 0.8rem;
    padding: 0.25rem 0.6rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.25rem;
  }

  /* ── footer ── */
  .footer {
    margin-top: auto;
    background: var(--surface);
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    padding-block: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer p {
    font-size: 0.875rem;
    color: var(--text-muted);
  }
</style>

<style is:global>
