---
import Base from "../layouts/Base.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
// The version the page advertises is the one it analyzes with: the analyzer is
// a dependency here, so a `npm update` moves the version strip and the Action
// pin below at the same time. Read at build time; nothing of it ships to the
// browser.
import { version } from "reactant-analyzer/package.json";
import { run } from "reactant-analyzer";
import { ansiToHtml } from "../lib/ansi";
import { annotate } from "../lib/annotate";

const repo = "https://github.com/rboudrouss/reactant-analyzer";
const npm = "https://www.npmjs.com/package/reactant-analyzer";
const doc = (file: string) => `${repo}/blob/main/docs/${file}`;

const install = "npx reactant-analyzer";

/*
 * The hero: two files, one loop. Editable, and both go into one run: the bug
 * is the pair, so editing either one has to re-check both.
 *
 * The path lives in the pane's bar rather than in a comment at the top of the
 * source, so the line numbers the analyzer prints are the ones on screen.
 * `setQuery` and `onChange` both sit on row 5 of their file: the wire drawn
 * between the panes (see `.wire` below) is positioned on that row, and only
 * while neither file has been edited.
 */
const crossFiles = [
  {
    id: "dashboard",
    path: "src/Dashboard.tsx",
    role: "owns the state",
    source: `import { useState } from "react";
import { Filters } from "./Filters";

export function Dashboard() {
  const [query, setQuery] =
    useState({ term: "" });
  return <Filters value={query} onChange={setQuery} />;
}
`,
  },
  {
    id: "filters",
    path: "src/Filters.tsx",
    role: "trims it and hands it back",
    source: `import { useEffect } from "react";

export function Filters({ value, onChange }) {
  useEffect(() => {
    onChange({ ...value, term: value.term.trim() });
  }, [value, onChange]);

  return <input value={value.term} readOnly />;
}
`,
  },
];

/*
 * The live example in section 01. One file per example on purpose: the hero
 * above has already made the cross-file point, so here each tab shows one more
 * shape the analyzer reports, and the notes beside the output explain how to
 * read a finding. Each source was run through the analyzer as it stands: the
 * label names the finding the run actually produces.
 */
const demos = [
  {
    id: "infinite-loop",
    label: "Infinite loop",
    path: "src/Cart.tsx",
    source: `import { useEffect, useState } from "react";

export function Cart({ lines }) {
  const [items, setItems] = useState([]);

  useEffect(() => {
    setItems([...items, ...lines]);
  }, [items, lines]);

  return <ul>{items.map((i) => <li>{i.label}</li>)}</ul>;
}
`,
  },
  {
    id: "derived-state",
    label: "Derived state",
    path: "src/Profile.tsx",
    source: `import { useEffect, useState } from "react";

export function Profile() {
  const [user, setUser] = useState({ first: "Ada" });
  const [full, setFull] = useState("");

  useEffect(() => {
    setFull(user.first + " Lovelace");
  }, [user]);

  return <h1>{full}</h1>;
}
`,
  },
  {
    id: "stale-closure",
    label: "Stale closure",
    path: "src/Timer.tsx",
    source: `import { useEffect, useState } from "react";

export function Timer() {
  const [count, setCount] = useState(0);

  useEffect(() => {
    const id = setInterval(() => {
      console.log("tick", count);
    }, 1000);
    return () => clearInterval(id);
  }, []);

  return <button onClick={() => setCount(count + 1)} />;
}
`,
  },
  {
    id: "unstable-context",
    label: "Context value",
    path: "src/Theme.tsx",
    source: `import { createContext, useState } from "react";

export const ThemeContext = createContext(null);

export function ThemeProvider({ children }) {
  const [theme, setTheme] = useState("light");

  return (
    <ThemeContext.Provider value={{ theme, setTheme }}>
      {children}
    </ThemeContext.Provider>
  );
}
`,
  },
  {
    id: "missing-cleanup",
    label: "Missing cleanup",
    path: "src/Presence.tsx",
    source: `import { useEffect, useState } from "react";

export function Presence({ socket }) {
  const [online, setOnline] = useState(0);

  useEffect(() => {
    socket.addEventListener("message", (e) => {
      setOnline(e.data.count);
    });
  }, [socket]);

  return <span>{online} online</span>;
}
`,
  },
  {
    id: "clean",
    label: "Clean",
    path: "src/Search.tsx",
    source: `import { useMemo, useState } from "react";

export function Search({ items }) {
  const [term, setTerm] = useState("");

  const matches = useMemo(
    () => items.filter((i) => i.name.includes(term)),
    [items, term],
  );

  return <ul>{matches.map((m) => <li>{m}</li>)}</ul>;
}
`,
  },
];

/*
 * The runs below are the analyzer, at the version this page advertises, run at
 * build time on exactly the sources above. A release that changes the wording,
 * the severity or the rule that fires moves the page with it, and a visitor
 * with no JavaScript still sees a real run. A few tens of milliseconds, and
 * nothing of it ships to the browser.
 *
 * The options are the ones the browser re-runs the pair with, so nothing
 * shifts when the script takes over. `showClean` is what makes the point
 * legible: `Dashboard` comes back ticked, the finding lands on `Filters`.
 */
const pairRun = await run({
  files: Object.fromEntries(crossFiles.map((f) => [f.path, f.source])),
  format: "human",
  color: true,
  showClean: true,
});
const pairOutput = ansiToHtml(pairRun.stdout.trimEnd());

/*
 * The first tab's run, so a visitor with no JavaScript still reads a real
 * finding with its trace step. The other tabs run in the browser on demand.
 * `showClean` is for the clean tab: its component line comes back ticked
 * instead of a note about a hidden component, so note 1 stays true there too.
 */
const demoRun = await run({
  files: { [demos[0].path]: demos[0].source },
  format: "human",
  color: true,
  trace: true,
  showClean: true,
});
const demoOutput = annotate(ansiToHtml(demoRun.stdout.trimEnd()));

const workflow = `name: reactant
on: [pull_request]
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: rboudrouss/reactant-analyzer@v${version}
        with:
          # the project root, so aliases load
          path: .
          # warnings annotate, never fail the PR
          fail-on: error`;

const plugin = `/plugin marketplace add rboudrouss/reactant-analyzer
/plugin install reactant@reactant-analyzer`;

/** The 17 diagnostics, grouped by the failure they describe, symptom first. */
const families: { label: string; rules: [string, string, string][] }[] = [
  {
    label: "Loops that never settle",
    rules: [
      ["The tab freezes, or React throws “Maximum update depth exceeded”.", "infinite-loop", "an effect sets state that re-triggers the effect, and the value never settles"],
      ["The same loop, but the setter belongs to the parent. Both files look fine alone.", "cross-component-infinite-loop", "a child effect sets parent state, the parent re-renders the child, the effect fires again"],
      ["A setter called while rendering. React warns, or loops.", "setter-in-render", "setState runs during the render body"],
      ["The same, but the setter arrived as a prop.", "cross-setter-in-render", "the same, reached through a prop"],
    ],
  },
  {
    label: "State that should not be state",
    rules: [
      ["One render shows the old value before the new one catches up.", "derived-state", "an effect only mirrors another state, so compute it during render"],
      ["Two renders where one would do, on every mount.", "unnecessary-rerender", "a mount-only effect immediately overwrites the initial state"],
      ["Nothing happens, and nobody remembers why the call is there.", "redundant-set-state", "setState is called with the value the state already holds"],
    ],
  },
  {
    label: "Values frozen in time",
    rules: [
      ["The interval logs the same count forever.", "stale-closure", "a long-lived callback keeps reading a value frozen from the moment the callback was created"],
      ["The prop changed but the component still shows the first value.", "frozen-initial-state", "useState is seeded from a prop that later changes, so the state sticks at the first value"],
    ],
  },
  {
    label: "Identity and mutation",
    rules: [
      ["You pushed to the array and nothing re-rendered.", "state-mutation", "a state or prop object is mutated in place, so the reference never changes and React skips the re-render"],
      ["Every consumer re-renders every time the provider does, even when nothing in the value changed.", "unstable-context-value", "a provider hands consumers a new object every render"],
      ["The expensive setup runs on every render instead of once.", "lazy-init", "a useState initializer calls a function on every render"],
    ],
  },
  {
    label: "Lifecycle and environment",
    rules: [
      ["Listeners pile up after each remount, twice under StrictMode.", "missing-cleanup", "an effect starts something long-lived and never cleans it up"],
      ["A hook in a Next.js Server Component, where hooks do not exist.", "server-component-hook", "a hook runs in a Next.js Server Component"],
    ],
  },
  {
    label: "Also covered by ESLint, followed further",
    rules: [
      ["The deps array misses a value, but the read is inside a helper or a custom hook in another file.", "missing-deps", "exhaustive-deps, followed through helpers and other files"],
      ["A dep is a fresh object or function every render, so the effect re-runs every time.", "always-unstable-deps", "partly covered by exhaustive-deps"],
      ["A hook call that is conditional once you follow the value, not the syntax.", "conditional-hook", "rules-of-hooks, followed when the condition is on a value, not only when the if is around the call"],
    ],
  },
];

const docs = [
  ["usage", doc("usage.md"), "every flag, JSON schema, exit codes"],
  ["limitations", doc("limitations.md"), "what it misses, what it may get wrong"],
  ["precision-log", doc("precision-log.md"), "every wrong warning, on 14 repositories"],
  ["custom-rules", doc("custom-rules.md"), "rule packs"],
  ["plugins", doc("plugins.md"), "the Rust API"],
  ["adr", `${repo}/tree/main/docs/adr`, "every design decision"],
];
---

<Base
  title="reactant, a static checker for React hooks"
  description="reactant reads your whole React project and finds the hook bugs that live between files: infinite render loops, stale values, useless re-renders, cross-component cycles that no ESLint rule catches. One command, no config."
>
  <header class="wrap">
    <div class="top">
      <a class="name" href="#top">reactant</a>
      <nav>
        <a href={repo} target="_blank" rel="noopener">GitHub</a>
        <a href={npm} target="_blank" rel="noopener">npm</a>
        <a href="#docs">Docs</a>
        <span class="v">v{version}</span>
        <ThemeToggle />
      </nav>
    </div>
  </header>

  <main id="top">
    {/* ── hero: what it is, the command, two files, the run ─────────────── */}
    <div class="wrap hero stack-lg">
      <div class="stack">
        <p class="eyebrow">reactant, a static checker for React hooks</p>
        <h1>Finds the infinite render loops, stale values and useless re-renders in your React project, across files.</h1>
        <p class="lead">
          reactant reads your React project as one program. It follows a state setter from the
          component that owns it to the effect in another file that calls it, and reports the loop on
          the component that suffers it.
        </p>
      </div>

      <div>
        <div class="cmd">
          <code><span class="npx">npx</span> reactant-analyzer</code>
          <div class="cmd-links">
            {/* Hidden until the script that fills it runs: with no JS the
                button would sit there doing nothing, and the command is still
                one click to select (user-select: all). */}
            <button class="copy" type="button" data-copy={install} hidden>copy</button>
            <a href={repo} target="_blank" rel="noopener">GitHub</a>
            <a href={npm} target="_blank" rel="noopener">npm</a>
            <a href="#docs">Documentation</a>
          </div>
        </div>
        <p class="cmd-note">
          Nothing to add to your project, nothing to configure. Node 20 or later. Vite and Next.js
          projects are detected on their own, tsconfig <code>paths</code> included.
        </p>
      </div>

      <figure>
        <div class="pair wired" id="pair">
          {
            crossFiles.map((file, i) => (
              <>
                {i === 1 && <div class="gutter" aria-hidden="true" />}
                <div class="pane">
                  <div class="pane-head">
                    <code>{file.path}</code>
                    <span class="role">
                      <span>{file.role}</span>
                      {/* One per file: a visitor who edited `Filters` wants
                          that file back, not the whole example. */}
                      <button class="reset" type="button" data-xfile-reset={file.id} hidden>
                        reset
                      </button>
                    </span>
                  </div>
                  <div class="editor-wrap" data-xfile={file.id}>
                    {/* Painted under the textarea, which goes transparent once
                        the script takes over. Until then the plain text is what
                        shows, so the code is readable with no JS and never
                        flashes blank. */}
                    <pre class="hl" aria-hidden="true" />
                    <textarea
                      class="editor"
                      wrap="off"
                      spellcheck="false"
                      autocapitalize="off"
                      autocorrect="off"
                      aria-label={file.path}>{file.source}</textarea
                    >
                    {/* The wire: the underline of `setQuery` continues past
                        `] =` to the pane edge, crosses the gutter, and picks up
                        again under the indent before `onChange`. Drawn on row 5
                        of each file, so it is removed on the first edit. */}
                    <i class={`wire ${file.id === "dashboard" ? "from" : "to"}`} aria-hidden="true" />
                  </div>
                </div>
              </>
            ))
          }
        </div>
      </figure>

      <figure>
        <div class="out-label">
          the run on these two files <span class="cmdline">reactant check . --show-clean</span>
        </div>
        <pre class="out" id="xfile-out" aria-live="polite" set:html={pairOutput} />
        <figcaption>
          The spread builds a new object every run. <code>Object.is</code> says it changed,
          <b>Dashboard</b> re-renders, <b>Filters</b> gets a new <code>value</code>, the effect runs
          again. It is a warning not an error because the analyzer saw the loop but could not prove that
          nothing stops it. 
        </figcaption>
      </figure>
    </div>

    {/* ── 01 what else crosses the gap, anatomy of a finding ────────────── */}
    <section id="finding">
      <div class="wrap stack-lg">
        <div class="stack">
          <h2>Anything that leaves a file is followed to where it lands.</h2>
          <p>
            A setter handed down as a prop, a custom hook imported from another file, a helper that
            wraps the hook call... and
            <code>--trace</code> prints the steps that led there, with a file and line for each.
          </p>
        </div>

        <div class="anatomy">
          <figure>
            {/* Hidden until the script that answers a click runs: without it
                the tabs would sit there doing nothing, and the first example
                is already on the page. */}
            <ul class="picker" role="tablist" aria-label="Examples" hidden>
              {
                demos.map((demo, i) => (
                  <li>
                    <button
                      class="pick"
                      type="button"
                      role="tab"
                      data-demo={demo.id}
                      aria-selected={i === 0 ? "true" : "false"}
                    >
                      {demo.label}
                    </button>
                  </li>
                ))
              }
            </ul>
            <div class="pane">
              <div class="pane-head">
                <code id="demo-path">{demos[0].path}</code>
                <span class="role">
                  <span>Try it !</span>
                  <button class="reset" type="button" id="demo-reset" hidden>reset</button>
                </span>
              </div>
              <div class="editor-wrap" id="demo-wrap">
                <pre class="hl" aria-hidden="true" />
                <textarea
                  class="editor"
                  id="demo-editor"
                  wrap="off"
                  spellcheck="false"
                  autocapitalize="off"
                  autocorrect="off"
                  aria-label="Source code">{demos[0].source}</textarea
                >
              </div>
            </div>
            <div class="out-label">
              <span class="cmdline">reactant check <span id="demo-cmd-path">{demos[0].path}</span> --trace --show-clean</span>
            </div>
            <pre class="out" id="demo-out" aria-live="polite" set:html={demoOutput} />
          </figure>
          <ol class="notes">
            <li data-n="1">
              The component that suffers the bug, and its file. In a two-file loop this is the child
              whose effect fires, not the parent that owns the state.
            </li>
            <li data-n="2">
              How sure it is. <b>error</b> means the analyzer proved it. <b>warn</b> means it saw the
              shape but could not rule out a path that stops it, as with <b>Filters</b> above.
            </li>
            <li data-n="3">
              The step it took, printed by <code>--trace</code>: the write or the read that keeps the
              finding alive, with its own line. A clean run prints only the component line and its tick.
            </li>
          </ol>
        </div>
      </div>
    </section>

    {/* ── 02 run it on yours ────────────────────────────────────────────── */}
    <section id="run">
      <div class="wrap stack-lg">
        <div class="stack">
          <h2>It says what it read, and what it did not.</h2>
        </div>

        <div>
          <div class="cmd big">
            <code><span class="npx">npx</span> reactant-analyzer</code>
            <div class="cmd-links">
              <button class="copy" type="button" data-copy={install} hidden>copy</button>
              <a href={doc("usage.md")} target="_blank" rel="noopener">every flag</a>
              <a href={doc("usage.md")} target="_blank" rel="noopener">exit codes</a>
            </div>
          </div>
          <p class="cmd-note">
            Node 20 or later. Nothing is added to your ESLint config or your build. Pointing it at a
            subdirectory (<code>npx reactant-analyzer src/features</code>) still runs inside the
            project the config files describe.
          </p>
        </div>

        <div class="cols">
          <figure>
            <div class="col-head">when every file was read</div>
            <pre class="out"><span class="green">✓  37 file(s) no issues found.</span></pre>
            <figcaption>
              That line is a claim about your code, so it is only printed when the run read
              everything it was pointed at.
            </figcaption>
          </figure>
          <figure>
            <div class="col-head">when something could not be read</div>
            <pre class="out"><span class="yellow">⚠  37 file(s), no findings, but parts of this run were not analyzed,
   so this is not a clean bill.</span>
   not analyzed:
     • no tsconfig `paths` found, so aliased imports (e.g. `@/...`) stay unresolved …
     • 3 imported file(s) resolved outside the analysed set and were never read …</pre>
            <figcaption>
              The same block prints under a run that did find things. The counts then cover only
              what was read. A file it was pointed at and could not read, or an import that resolved
              to a file it did not read, is listed here rather than counted as clean.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    {/* ── 03 what it catches ────────────────────────────────────────────── */}
    <section id="rules">
      <div class="wrap stack-lg">
        <div class="stack">
          <h2>Seventeen rules, sorted by what you see in the browser.</h2>
          <p>
            The left column is what you saw in the browser. The right is the rule that names it.
            <code>reactant rules</code> lists them, plus two informational entries the run uses to say
            where it could not look. <code>reactant explain &lt;rule&gt;</code> gives an example and a
            fix for one.
          </p>
        </div>

        <table class="rules">
          <tbody>
            {
              families.map((family) => (
                <>
                  <tr class="group"><th colspan="2">{family.label}</th></tr>
                  {family.rules.map(([symptom, rule, what]) => (
                    <tr>
                      <td>{symptom}</td>
                      <td>
                        <code class="rule">{rule}</code><span class="what">{what}</span>
                      </td>
                    </tr>
                  ))}
                </>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    {/* ── 04 where it fits ──────────────────────────────────────────────── */}
    <section id="fits">
      <div class="wrap stack-lg">
        <div class="stack">
          <h2>Keep ESLint. Keep the compiler. Add this before merge.</h2>
          <p>
            Keep <code>eslint-plugin-react-hooks</code> in the editor. It runs as you type and is right
            about the rules of hooks inside a file. Keep React Compiler in the build if you use it: it
            caches values where it compiles, but it cannot break a loop whose value keeps changing, and
            it skips components it cannot compile without saying so. Add reactant before merge. It is
            slower than a linter because it reads the whole project at once.
          </p>
        </div>

        <table class="fit">
          <thead>
            <tr><th>where</th><th>tool</th><th>what it reads</th><th class="num-col">one run</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>In the editor</td>
              <td><code class="rule">eslint-plugin-react-hooks</code></td>
              <td>the file you are typing in, as syntax</td>
              <td class="num-col">milliseconds</td>
            </tr>
            <tr>
              <td>In the build</td>
              <td>React Compiler</td>
              <td>one function at a time, to memoize it</td>
              <td class="num-col">part of the build</td>
            </tr>
            <tr>
              <td>Before merge</td>
              <td><code class="rule">reactant</code></td>
              <td>the whole project, as values across renders and files</td>
              <td class="num-col">1.8 s for 528 files (excalidraw), 76 s for 4,195 (dub)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    {/* ── 05 in CI ──────────────────────────────────────────────────────── */}
    <section id="ci">
      <div class="wrap stack-lg">
        <div class="stack">
          <p class="eyebrow"><span class="num">05</span> In CI</p>
          <h2>The repository is also a GitHub Action. Every finding becomes a line annotation on the PR.</h2>
        </div>

        <div class="cols">
          <figure>
            <div class="col-head">.github/workflows/reactant.yml</div>
            <pre class="block wrap-ok">{workflow}</pre>
            <figcaption>
              Inputs and outputs are in <a href={`${repo}/blob/main/action.yml`} target="_blank" rel="noopener">action.yml</a>.
              <code>--format json</code> gives the same report to machines, one JSON document with the
              steps behind every finding.
            </figcaption>
          </figure>
          <div class="stack">
            <h3>For code an assistant wrote</h3>
            <p>
              AI assistants write these shapes a lot, behind enough helpers that a pattern match never
              fires. Because the JSON carries the steps that led to each finding, an agent can fix the
              cause instead of the line. reactant also ships as a Claude Code plugin:
            </p>
            <pre class="block wrap-ok">{plugin}</pre>
            <p class="small muted">
              <code>reactant-triage</code> runs the analyzer and sorts each finding into real, false,
              or not worth fixing. <code>reactant-rules</code> writes custom rule packs.
            </p>
            <h3>Your team's own rules</h3>
            <p>
              You can write your own team conventions that ships as rule packs, in JSON or JavaScript, written against what the
              analyzer already worked out (which hook a value came from, what a setter writes) rather
              than against source patterns, so they survive refactoring. See
              <a href={doc("custom-rules.md")} target="_blank" rel="noopener">docs/custom-rules.md</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── 06 trust ──────────────────────────────────────────────────────── */}
    <section id="limits">
      <div class="wrap stack-lg">
        <div class="stack">
          <h2>When it says error, it is a bug. When it is not sure, it says warn.</h2>
        </div>

        <div class="cols">
          <div>
            <div class="col-head"><span class="accent">error</span> is proven</div>
            <p>
              An Error can only be produced from a proof. The code that reports rules has no way to
              mark something Error on a guess. So an Error is a
              bug in your code. If one ever is not, that is a bug in the
              analyzer.
            </p>
          </div>
          <div>
            <div class="col-head"><span class="accent">warn</span> is a maybe</div>
            <p>
              Warnings can be wrong. A finding that turns out to be fine is always a Warning or below,
              never an Error. Every known case is listed in the
              <a href={doc("limitations.md")} target="_blank" rel="noopener">limitations page</a> with
              its issue, and <code>--fail-on error</code> lets CI ignore Warnings while they still
              annotate the PR. If one is wrong on your code,
              <a href={`${repo}/issues`} target="_blank" rel="noopener">open an issue</a>: wrong
              warnings are filed under <code>precision-fp</code>, measured, and listed on the
              limitations page.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── 07 how it works ───────────────────────────────────────────────── */}
    <section class="how" id="how">
      <div class="wrap stack">
        <h2>It runs your render in its head until the values stop moving.</h2>
        <p>
          reactant turns each component into a small model of its render and its effects, and works
          out what every <code>useState</code> can hold from one render to the next
          <span class="term">(abstract interpretation, in the textbook sense)</span>. It repeats the
          render until nothing changes any more, then reports the shapes that never settle, go stale,
          or re-render everyone. Setters are followed through props and imports, custom hooks are read
          as if inlined, and the finding is placed on the component that suffers it.
        </p>
        <p>
          An Error can only be produced from a proof; the analysis errs the other way
          <span class="term">
            (we try to be sound: it would rather warn too much than miss a bug, so what it misses is listed
            as a limit rather than hidden)
          </span>. The rules for how React re-renders are taken from React-tRace, a formal model of
          hooks published at OOPSLA 2025, so the analyzer and React agree on what a re-render is.
        </p>
      </div>
    </section>
  </main>

