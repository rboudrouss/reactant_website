---
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
// The version the page advertises is the one it analyzes with: the analyzer is
// a dependency here, so a `npm update` moves the badge and the Action pin below
// at the same time. Read at build time; nothing of it ships to the browser.
import { version } from "reactant-analyzer/package.json";
import { run } from "reactant-analyzer";
import { ansiToHtml } from "../lib/ansi";

const repo = "https://github.com/rboudrouss/reactant-analyzer";
const npm = "https://www.npmjs.com/package/reactant-analyzer";

const install = `npx reactant-analyzer`;

/** Rendered twice: the top bar, and the scrollable row narrow screens get. */
const sections: [string, string][] = [
  ["#example", "Example"],
  ["#rules", "Rules"],
  ["#comparison", "Comparison"],
  ["#ci", "CI"],
  ["#docs", "Docs"],
];

/*
 * The cross-file example, editable like the hero demo. Both files go into one
 * run: the bug is the pair, so editing either one has to re-check both.
 *
 * The path lives in the pane's bar rather than in a comment at the top of the
 * source, so the line numbers the analyzer prints are the ones on screen.
 */
const crossFiles = [
  {
    id: "dashboard",
    path: "src/Dashboard.tsx",
    source: `import { useState } from "react";
import { Filters } from "./Filters";

export function Dashboard() {
  const [query, setQuery] = useState({ term: "", tags: [] });
  return <Filters value={query} onChange={setQuery} />;
}
`,
  },
  {
    id: "filters",
    path: "src/Filters.tsx",
    source: `import { useEffect } from "react";

export function Filters({ value, onChange }) {
  useEffect(() => {
    onChange({ ...value, term: value.term.trim() });   // a new object, every run
  }, [value, onChange]);

  return <input value={value.term} />;
}
`,
  },
];

/*
 * The first paint of that run is not transcribed: it is the analyzer, at the
 * version this page advertises, run at build time on exactly the sources above.
 * A release that changes the wording, the severity or the rule that fires moves
 * the page with it, and a visitor with no JavaScript still sees a real run.
 * ~40ms, and nothing of it ships to the browser.
 *
 * `showClean` is what makes the point legible: `Dashboard` comes back ticked,
 * the finding lands on `Filters`, and neither file holds the bug alone. The
 * options match the ones the browser re-runs with, so nothing shifts when the
 * script takes over.
 */
const crossFileRun = await run({
  files: Object.fromEntries(crossFiles.map((file) => [file.path, file.source])),
  command: "check",
  color: true,
  trace: true,
  showClean: true,
});
const crossFileOutput = ansiToHtml(crossFileRun.stdout.trimEnd());

const workflow = `name: reactant
on: [pull_request]
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: rboudrouss/reactant-analyzer@v${version}
        with:
          path: .              # the project root, so tsconfig aliases load
          fail-on: error       # warnings annotate the PR without failing it`;

const plugin = `/plugin marketplace add rboudrouss/reactant-analyzer
/plugin install reactant@reactant-analyzer`;

const packConfig = `{
  "packs": ["@team/react-rules", "./rules/pack.json"],
  "rules": {
    "team/oversized-effect": { "severity": "warning" },
    "team/banned-hook": "off"
  }
}`;

/*
 * The live demo in the hero. One component per example on purpose: a tree of
 * several files is exactly what reactant is for, but a two-file toy in a
 * playground teaches the opposite lesson: that it works file by file. The
 * cross-file story is told properly in the section below instead.
 *
 * Each source was run through the analyzer as it stands: the label names the
 * finding the run actually produces, not the one the code was written for.
 */
const demos = [
  {
    id: "infinite-loop",
    label: "Infinite loop",
    path: "src/Cart.tsx",
    source: `import { useEffect, useState } from "react";

export function Cart({ lines }) {
  const [items, setItems] = useState([]);

  useEffect(() => {
    setItems([...items, ...lines]);
  }, [items, lines]);

  return <ul>{items.map((i) => <li>{i.label}</li>)}</ul>;
}
`,
  },
  {
    id: "derived-state",
    label: "Derived state",
    path: "src/Profile.tsx",
    source: `import { useEffect, useState } from "react";

export function Profile() {
  const [user, setUser] = useState({ first: "Ada" });
  const [full, setFull] = useState("");

  useEffect(() => {
    setFull(user.first + " Lovelace");
  }, [user]);

  return <h1>{full}</h1>;
}
`,
  },
  {
    id: "stale-closure",
    label: "Stale closure",
    path: "src/Timer.tsx",
    source: `import { useEffect, useState } from "react";

export function Timer() {
  const [count, setCount] = useState(0);

  useEffect(() => {
    const id = setInterval(() => {
      console.log("tick", count);
    }, 1000);
    return () => clearInterval(id);
  }, []);

  return <button onClick={() => setCount(count + 1)} />;
}
`,
  },
  {
    id: "unstable-context",
    label: "Context value",
    path: "src/Theme.tsx",
    source: `import { createContext, useState } from "react";

export const ThemeContext = createContext(null);

export function ThemeProvider({ children }) {
  const [theme, setTheme] = useState("light");

  return (
    <ThemeContext.Provider value={{ theme, setTheme }}>
      {children}
    </ThemeContext.Provider>
  );
}
`,
  },
  {
    id: "missing-cleanup",
    label: "Missing cleanup",
    path: "src/Presence.tsx",
    source: `import { useEffect, useState } from "react";

export function Presence({ socket }) {
  const [online, setOnline] = useState(0);

  useEffect(() => {
    socket.addEventListener("message", (e) => {
      setOnline(e.data.count);
    });
  }, [socket]);

  return <span>{online} online</span>;
}
`,
  },
  {
    id: "clean",
    label: "Clean",
    path: "src/Search.tsx",
    source: `import { useMemo, useState } from "react";

export function Search({ items }) {
  const [term, setTerm] = useState("");

  const matches = useMemo(
    () => items.filter((i) => i.name.includes(term)),
    [items, term],
  );

  return <ul>{matches.map((m) => <li>{m}</li>)}</ul>;
}
`,
  },
];

/** The 17 diagnostics, grouped by the failure they describe. */
const families = [
  {
    label: "Loops that never settle",
    rules: [
      ["infinite-loop", "an effect sets state that re-triggers the effect, and the value never settles"],
      ["cross-component-infinite-loop", "a child effect sets parent state, the parent re-renders the child, the effect fires again"],
      ["setter-in-render", "setState runs during the render body"],
      ["cross-setter-in-render", "the same, reached through a prop"],
    ],
  },
  {
    label: "State that should not be state",
    rules: [
      ["derived-state", "an effect only mirrors another state, so compute it during render"],
      ["unnecessary-rerender", "a mount-only effect immediately overwrites the initial state"],
      ["redundant-set-state", "setState is called with the value the state already holds"],
    ],
  },
  {
    label: "Values frozen in time",
    rules: [
      ["stale-closure", "a long-lived callback keeps reading a value frozen at registration time"],
      ["frozen-initial-state", "useState is seeded from a prop that later changes, so the state sticks at the first value"],
    ],
  },
  {
    label: "Identity and mutation",
    rules: [
      ["state-mutation", "a state or prop object is mutated in place, so the reference never changes and React skips the re-render"],
      ["unstable-context-value", "a provider hands consumers a new object every render"],
      ["lazy-init", "a useState initializer calls a function on every render"],
    ],
  },
  {
    label: "Lifecycle and environment",
    rules: [
      ["missing-cleanup", "an effect starts something long-lived and returns no teardown"],
      ["server-component-hook", "a hook runs in a Next.js Server Component, where hooks do not exist"],
    ],
  },
  {
    label: "Also covered by ESLint",
    note: "reactant follows the value rather than the syntax, so these also fire through helpers and cross-file custom hooks.",
    rules: [
      ["missing-deps", "exhaustive-deps, carried through indirection"],
      ["always-unstable-deps", "partly covered by exhaustive-deps"],
      ["conditional-hook", "rules-of-hooks, carried past the lexical case"],
    ],
  },
];

/*
 * The three tools, in the order they run: the editor, the build, the gate
 * before merge. This is the part of the section that matters — the table under
 * it only says what each one sees, and a table alone reads as a scoreboard.
 */
const roles = [
  {
    name: "eslint-plugin-react-hooks",
    when: "In your editor, as you type",
    cost: "a few ms per file",
    role: "It checks the lexical rules of hooks, such as the deps array and the conditional call. It runs on every keystroke because it never leaves the file it is reading.",
    limit:
      "It matches patterns in the AST. Move the hook call into a helper, or into a custom hook in another file, and the pattern no longer matches.",
  },
  {
    name: "React Compiler",
    when: "In your build",
    cost: "part of the build",
    role: "It memoizes for you. Where it compiles, it removes the re-renders that unstable references cause.",
    limit:
      "It optimizes and does not report bugs. When it cannot compile a component it skips it without saying so.",
  },
  {
    name: "reactant",
    when: "In CI, or before a commit",
    cost: "1.8s for 528 files",
    role: "It tracks what each value can hold across renders and across files. It follows setters through the call graph and inlines custom hooks.",
    limit:
      "It builds a graph of the whole project before it reports anything, so it cannot run on every keystroke. One run takes seconds and covers every file at once.",
  },
];

/*
 * Two kinds of blank, and they are not the same admission.
 *
 * `none` is a choice of scope: the tool could do it and does not. `bad` is a
 * limit of the method. ESLint reads the shape of the code, and these bugs are
 * not in the shape: you have to know what a value holds on the next render, or
 * what a setter does once another file calls it. That is not a rule anyone
 * forgot to write, which is why the label names the method and not a gap.
 */
const tools = ["ESLint", "reactant"];

const matrix = [
  ["Unused vars, imports, style", ["ok", "catches"], ["none", "not its job"]],
  ["Conditional hook call", ["ok", "catches"], ["ok", "catches"]],
  ["Missing effect dep", ["warn", "same file only"], ["ok", "catches"]],
  ["Unstable dep or context value", ["warn", "same file only"], ["ok", "catches"]],
  ["Infinite render loop", ["bad", "syntax only"], ["ok", "catches"]],
  ["Derived state in an effect", ["bad", "syntax only"], ["ok", "catches"]],
  ["Stale closure", ["bad", "syntax only"], ["ok", "catches"]],
  ["Cross-component cycle", ["bad", "syntax only"], ["ok", "catches"]],
];

const docs = [
  ["docs/usage.md", `${repo}/blob/main/docs/usage.md`, "every flag, the JSON schema, project detection, exit codes"],
  ["docs/custom-rules.md", `${repo}/blob/main/docs/custom-rules.md`, "writing rule packs"],
  ["docs/limitations.md", `${repo}/blob/main/docs/limitations.md`, "what it misses and what it may report wrongly"],
  ["docs/plugins.md", `${repo}/blob/main/docs/plugins.md`, "the Rust API for custom discoverers and resolvers"],
  ["docs/adr/", `${repo}/tree/main/docs/adr`, "how the analysis works and why each decision was made"],
];
---

<Base
  title="reactant: a static analyzer for React hook bugs"
  description="Finds React hook bugs that ESLint has no rule for: infinite render loops, derived state, stale closures, cross-component cycles. Whole-program analysis, shipped as a CLI, an npm package and a GitHub Action."
>
  <div class="page">
    <nav class="topnav">
      <div class="container nav-inner">
        <a class="nav-name" href="#top">reactant</a>
        <ul class="nav-links">
          {sections.map(([href, label]) => (
            <li class="nav-section"><a href={href}>{label}</a></li>
          ))}
          <li><a href={repo} target="_blank" rel="noopener">GitHub</a></li>
          <li><ThemeToggle /></li>
        </ul>
      </div>

      {/* Narrow screens only: the same anchors on a second, scrollable row,
          because the bar above drops them and the page is long enough that
          losing every anchor leaves nothing but scrolling. */}
      <div class="nav-scroll">
        <ul class="container nav-scroll-inner">
          {sections.map(([href, label]) => (
            <li><a href={href}>{label}</a></li>
          ))}
        </ul>
      </div>
    </nav>

    <header id="top" class="hero">
      <div class="container hero-inner">
        <h1>reactant</h1>
        <p class="hero-title">A static analyzer for React hook bugs</p>
        <p class="hero-bio">
          Finds the bugs ESLint has no rule for: <strong>infinite render loops</strong>, effects that
          mirror state instead of computing it, callbacks stuck reading a value <strong
            >frozen at mount</strong
          >, providers that re-render every consumer on every render.
        </p>
        <div class="install">
          <div class="install-cmd">
            <Code code={install} lang="sh" themes={{ light: "github-light", dark: "github-dark-dimmed" }}
              defaultColor={false} />
            {/* Hidden until the script that fills it runs: with no JS the
                button would sit there doing nothing. */}
            <button class="copy" type="button" id="install-copy" data-copy={install} hidden>
              <span class="copy-label">Copy</span>
            </button>
          </div>
          <p class="install-note">
            Nothing to install, nothing to configure. Node 20 or later. Vite and Next.js projects are
            detected on their own, tsconfig <code>paths</code> included.
          </p>
        </div>
        <div class="hero-links">
          <a class="btn" href={repo} target="_blank" rel="noopener">GitHub</a>
          <a class="btn btn-ghost" href={npm} target="_blank" rel="noopener">npm</a>
          <a class="btn btn-ghost" href="#docs">Documentation</a>
        </div>

        <p class="badges">
          <a href={`${npm}/v/${version}`} target="_blank" rel="noopener">v{version}</a>
          <span aria-hidden="true">·</span>
          <a href={`${repo}/blob/main/LICENSE`} target="_blank" rel="noopener">MIT</a>
          <span aria-hidden="true">·</span>
          <span>Node 20+</span>
          <span aria-hidden="true">·</span>
          <span>no config</span>
          <span aria-hidden="true">·</span>
          <a href={`${repo}/releases`} target="_blank" rel="noopener">Changelog</a>
        </p>
      </div>

      <div class="container demo">
        <ul class="picker" role="tablist" aria-label="Examples">
          {
            demos.map((demo, i) => (
              <li>
                <button
                  class="pick"
                  type="button"
                  role="tab"
                  data-demo={demo.id}
                  aria-selected={i === 0 ? "true" : "false"}
                >
                  {demo.label}
                </button>
              </li>
            ))
          }
        </ul>

        <div class="panes">
          <div class="pane-src">
            <div class="pane-bar">
              <span class="path" id="demo-path">{demos[0].path}</span>
              <button class="reset" type="button" id="demo-reset" hidden>Reset</button>
            </div>
            <div class="editor-wrap" id="demo-wrap">
              {/* Painted under the textarea, which goes transparent once the
                  script takes over. Until then the plain text is what shows,
                  so the code is readable with no JS and never flashes blank. */}
              <pre class="hl" id="demo-hl" aria-hidden="true"></pre>
              <textarea
                id="demo-editor"
                class="editor"
                wrap="off"
                spellcheck="false"
                autocapitalize="off"
                autocorrect="off"
                aria-label="Source code">{demos[0].source}</textarea
              >
            </div>
          </div>

          <figure class="terminal">
            <div class="terminal-bar">
              <span class="dots"><i></i><i></i><i></i></span>
              <span class="terminal-title">reactant check .</span>
            </div>
            <pre class="out" id="demo-out" aria-live="polite" aria-busy="true">Loading…</pre>
          </figure>
        </div>

        {/* The perf numbers used to sit in a caption under the demo, where the
            one figure that answers "can I put this in CI?" read as a footnote. */}
        <dl class="stats">
          <div class="stat">
            <dt>528 files in 1.8s</dt>
            <dd>excalidraw, whole-program, from cold</dd>
          </div>
          <div class="stat">
            <dt>4,195 files in 76s</dt>
            <dd>dub, the same run on a monorepo</dd>
          </div>
          <div class="stat">
            <dt>17 diagnostics</dt>
            <dd>most with no ESLint counterpart</dd>
          </div>
        </dl>
        <p class="stats-note">
          A whole-program fixpoint, not a pass per file.
        </p>
      </div>
    </header>

    <main>
      <section id="example" class="section">
        <div class="container">
          <h2 class="section-title">Two correct files, one infinite loop</h2>
          <p>
            <code>Dashboard</code> owns the state. <code>Filters</code> trims it and hands it back.
            Neither file is wrong on its own.
          </p>
          <div class="code-pair">
            {
              crossFiles.map((file) => (
                <div class="pane-src">
                  <div class="pane-bar">
                    <span class="path">{file.path}</span>
                    {/* One per file: a visitor who edited `Filters` wants that
                        file back, not the whole example. */}
                    <button class="reset" type="button" data-xfile-reset={file.id} hidden>
                      Reset
                    </button>
                  </div>
                  <div class="editor-wrap" data-xfile={file.id}>
                    {/* Painted under the textarea, which goes transparent once the
                        script takes over. Until then the plain text is what shows. */}
                    <pre class="hl" aria-hidden="true" />
                    <textarea
                      class="editor"
                      wrap="off"
                      spellcheck="false"
                      autocapitalize="off"
                      autocorrect="off"
                      aria-label={file.path}>{file.source}</textarea
                    >
                  </div>
                </div>
              ))
            }
          </div>

          <figure class="terminal static-run">
            <div class="terminal-bar">
              <span class="dots"><i></i><i></i><i></i></span>
              <span class="terminal-title">reactant check .</span>
            </div>
            <pre class="out" id="xfile-out" aria-live="polite" set:html={crossFileOutput} />
          </figure>
          <div class="callout">
            <p>
              The spread builds a new object every run. <code>Object.is</code> fails, the parent re-renders,
              the child gets a new <code>value</code>, the effect fires again.
            </p>
            <p>
              ESLint passes both files: the deps array is complete, no hook is conditional. reactant
              follows <code>setQuery</code> across the import. The finding names both ends of the cycle:
              the effect in <code>Filters</code>, the setter it borrows from <code>Dashboard</code>.
            </p>
          </div>
        </div>
      </section>

      <section id="rules" class="section">
        <div class="container">
          <h2 class="section-title">What it catches</h2>
          <p>
            Seventeen diagnostics. Most have no ESLint counterpart. <code>reactant rules</code> lists them
            all, <code>reactant explain &lt;rule&gt;</code> gives an example and a fix for one.
          </p>
          <div class="families">
            {
              families.map((family) => (
                <div class="family">
                  <h3 class="family-label">{family.label}</h3>
                  {family.note && <p class="family-note">{family.note}</p>}
                  <dl class="rule-list">
                    {family.rules.map(([name, what]) => (
                      <div class="rule">
                        <dt><code>{name}</code></dt>
                        <dd>{what}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section id="comparison" class="section band">
        <div class="container">
          <h2 class="section-title">Where reactant fits</h2>
          <p>
            reactant does not replace ESLint or React Compiler. Each one runs at a different moment.
            ESLint checks the file you are typing in, the compiler rewrites your code at build time,
            and reactant checks the whole project in CI. Installing reactant changes nothing in your
            ESLint config and nothing in your build.
          </p>

          <div class="roles">
            {
              roles.map((role) => (
                <div class="role">
                  <h3 class="role-name">{role.name}</h3>
                  <p class="role-when">
                    {role.when} <span class="role-cost">{role.cost}</span>
                  </p>
                  <p class="role-for">{role.role}</p>
                  <p class="role-limit">{role.limit}</p>
                </div>
              ))
            }
          </div>

          <h3 class="table-title">What each one catches</h3>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Bug class</th>
                  <th>ESLint</th>
                  <th>reactant</th>
                </tr>
              </thead>
              <tbody>
                {
                  matrix.map(([bug, ...cells]) => (
                    <tr>
                      <th scope="row">{bug}</th>
                      {cells.map(([verdict, label], i) => (
                        <td data-tool={tools[i]}>
                          <span class:list={["chip", verdict]}>{label}</span>
                        </td>
                      ))}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
      </section>

      <section id="ci" class="section">
        <div class="container">
          <h2 class="section-title">In CI</h2>
          <p>
            The repository is also a GitHub Action. Every finding becomes an annotation on the file and
            line that produced it.
          </p>
          <Code code={workflow} lang="yaml" themes={{ light: "github-light", dark: "github-dark-dimmed" }}
            defaultColor={false} />
          <p class="note">
            Inputs and outputs are documented in <a
              href={`${repo}/blob/main/action.yml`}
              target="_blank"
              rel="noopener">action.yml</a
            >.
          </p>
        </div>
      </section>

      <section id="ai" class="section">
        <div class="container">
          <h2 class="section-title">For AI-generated code</h2>
          <p>
            LLMs write exactly these bugs, and they write them behind enough abstraction that AST
            patterns never fire. <code>--format json</code> gives a machine-readable report where every
            finding carries a witness chain, the typed steps that led to it, so an agent can fix the cause
            instead of the line.
          </p>
          <p>reactant also ships as a Claude Code plugin:</p>
          <Code code={plugin} lang="text" themes={{ light: "github-light", dark: "github-dark-dimmed" }}
            defaultColor={false} />
          <p class="note">
            <code>reactant-triage</code> runs the analyzer and sorts each finding into true positive,
            false positive, or not worth fixing. <code>reactant-rules</code> writes custom rule packs.
          </p>
        </div>
      </section>

      <section id="packs" class="section">
        <div class="container">
          <h2 class="section-title">Team rules</h2>
          <p>
            Team conventions ship as rule packs, written against facts the engine already resolved
            (which hook a value came from, what a setter writes, what a selector returns) rather than
            against source patterns, so they survive refactoring. Written in JSON or JavaScript.
          </p>
          <Code code={packConfig} lang="json" themes={{ light: "github-light", dark: "github-dark-dimmed" }}
            defaultColor={false} />
        </div>
      </section>

      <section id="docs" class="section">
        <div class="container">
          <h2 class="section-title">Documentation</h2>
          <ul class="doc-list">
            {
              docs.map(([name, href, desc]) => (
                <li>
                  {/* All on one line: any newline here collapses to a space and
                      the colon drifts off the name it belongs to. */}
                  {/* prettier-ignore */}
                  <a href={href} target="_blank" rel="noopener">{name}</a><span class="muted">: {desc}</span>
                </li>
              ))
            }
          </ul>
          <div class="tags">
            <span class="tag">Rust</span>
            <span class="tag">Abstract interpretation</span>
            <span class="tag">WebAssembly</span>
            <span class="tag">React</span>
            <span class="tag">MIT licensed</span>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <p><strong>reactant</strong>, built by <a href="https://rboud.com">Réda Boudrouss</a></p>
        <p>
          <a href={repo} target="_blank" rel="noopener">GitHub</a>
          &nbsp;·&nbsp;
          <a href={npm} target="_blank" rel="noopener">npm</a>
          &nbsp;·&nbsp;
          <a href={`${repo}/issues`} target="_blank" rel="noopener">Issues</a>
        </p>
      </div>
    </footer>
  </div>

  <script id="demo-data" type="application/json" set:html={JSON.stringify(demos)} is:inline />
  <script
    id="cross-file-data"
    type="application/json"
    set:html={JSON.stringify(crossFiles)}
    is:inline
  />

  {/* Kept out of the demo module below on purpose: that one imports the
      WebAssembly analyzer, and a failure there must not take the copy button
      with it. */}
  <script is:inline>
    (() => {
      const button = document.getElementById("install-copy");
      if (!button || !navigator.clipboard) return;
      const label = button.querySelector(".copy-label");
      button.hidden = false;

      let revert;
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy);
        } catch {
          return; // A denied permission leaves the command there to select.
        }
        label.textContent = "Copied";
        button.dataset.copied = "";
        clearTimeout(revert);
        revert = setTimeout(() => {
          label.textContent = "Copy";
          delete button.dataset.copied;
        }, 1600);
      });
    })();
  </script>
</Base>

<script>
  import { initWasm, run, UsageError } from "reactant-analyzer/browser";
  // Vite emits the `.wasm` as an asset and hands back its final URL. Without
  // this the glue fetches the bytes next to itself, which is the source path in
  // dev and a hashed chunk with no `.wasm` beside it in a build. The specifier
  // is an alias onto the file in node_modules, defined in astro.config.mjs
  // because the package's `exports` map does not expose it.
  import wasmUrl from "reactant-analyzer/wasm-binary?url";
  import { ansiToHtml } from "../lib/ansi";
  import { highlight } from "../lib/highlight";

  type Source = { id: string; path: string; source: string };
  type Demo = Source & { label: string };

  const data = <T,>(id: string): T =>
    JSON.parse(document.getElementById(id)!.textContent!);

  const demos = data<Demo[]>("demo-data");
  const crossFiles = data<Source[]>("cross-file-data");

  // ── panes ───────────────────────────────────────────────────────────────────

  type Pane = {
    /** What is in the box, which is not the pristine source once edited. */
    read: () => string;
    /** Put text in the box and repaint; used by the picker and by Reset. */
    load: (text: string) => void;
  };

  /**
   * Wire one editable pane: the highlighted layer under the caret, the box that
   * grows with its content, and a callback for every keystroke.
   */
  function mountPane(wrap: HTMLElement, onInput: () => void): Pane {
    const hl = wrap.querySelector(".hl") as HTMLPreElement;
    const editor = wrap.querySelector(".editor") as HTMLTextAreaElement;

    /** Keep the painted copy at the same offset as the text over it. */
    const sync = () => {
      hl.scrollLeft = editor.scrollLeft;
      hl.scrollTop = editor.scrollTop;
    };

    /** Grow the box to its content: a scrollbar on ten lines of code reads badly. */
    const refresh = () => {
      editor.rows = editor.value.split("\n").length;
      hl.innerHTML = highlight(editor.value);
      sync();
    };

    editor.addEventListener("input", () => {
      refresh();
      onInput();
    });
    editor.addEventListener("scroll", sync);

    refresh();
    // The layer only takes over once it holds something to show.
    wrap.classList.add("lit");

    return {
      read: () => editor.value,
      load(text) {
        editor.value = text;
        refresh();
      },
    };
  }

  // ── the runs ────────────────────────────────────────────────────────────────

  // One WebAssembly instance, and the analysis cannot be reentered, so every
  // run on the page goes through this one chain: the hero demo and the
  // cross-file example take turns rather than collide.
  let chain: Promise<unknown> = Promise.resolve();

  function exclusive<T>(job: () => Promise<T>): Promise<T> {
    const next = chain.then(job, job);
    chain = next.catch(() => {});
    return next;
  }

  /**
   * An analyze-and-print loop for one terminal. `collect` is read at the last
   * moment, so a run always reports on what is in the boxes when it starts.
   */
  function runner(out: HTMLPreElement, collect: () => Record<string, string>) {
    let running = false;
    /** A run asked for while one was in flight: the inputs moved under it. */
    let again = false;

    async function analyze(): Promise<void> {
      if (running) {
        again = true;
        return;
      }
      running = true;
      out.ariaBusy = "true";

      // The analysis holds the thread for its duration, so yield once and let
      // the browser paint before it starts.
      await new Promise((resolve) => requestAnimationFrame(resolve));

      try {
        // `trace` and `showClean` are always on: the examples are small enough
        // that neither adds noise, and both replace a line telling the reader
        // to rerun with a flag this page has no button for. The cross-file run
        // needs `showClean` for its point: one file comes back ticked.
        const { stdout, stderr } = await exclusive(() =>
          run({
            files: collect(),
            format: "human",
            color: true,
            trace: true,
            showClean: true,
          }),
        );
        out.innerHTML = ansiToHtml(stdout + stderr) || "(no output)";
      } catch (error) {
        // A finding is a result; only a usage error throws. Anything else is
        // this page's own fault and should read like it.
        const prefix = error instanceof UsageError ? "usage error" : "demo error";
        out.innerHTML = `<span class="red">${prefix}:</span> ${
          error instanceof Error ? error.message : String(error)
        }`;
      } finally {
        out.ariaBusy = "false";
        running = false;
      }

      // Whatever changed mid-run is in the inputs now, so honour it.
      if (again) {
        again = false;
        await analyze();
      }
    }

    return analyze;
  }

  // Typing re-runs on its own: a run is a couple of milliseconds, and a Run
  // button is one more thing to explain in a hero.
  function debounced(analyze: () => void): () => void {
    let timer: number | undefined;
    return () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(analyze, 400);
    };
  }

  // ── the hero demo: one file, six examples ───────────────────────────────────

  const pathLabel = document.getElementById("demo-path") as HTMLSpanElement;
  const demoReset = document.getElementById("demo-reset") as HTMLButtonElement;
  const demoOut = document.getElementById("demo-out") as HTMLPreElement;

  /** The visitor's edits, per example; `demos` keeps the pristine text. */
  const edited = new Map<string, string>();
  let current = demos[0];

  const sourceOf = (demo: Demo) => edited.get(demo.id) ?? demo.source;

  const demoAnalyze = runner(demoOut, () => {
    // Remember the edit before reporting on it, so leaving the example and
    // coming back shows the same text.
    if (demoPane.read() !== sourceOf(current)) {
      edited.set(current.id, demoPane.read());
      demoReset.hidden = false;
    }
    return { [current.path]: demoPane.read() };
  });

  const demoPane = mountPane(
    document.getElementById("demo-wrap") as HTMLDivElement,
    debounced(demoAnalyze),
  );

  function select(demo: Demo) {
    current = demo;
    pathLabel.textContent = demo.path;
    demoPane.load(sourceOf(demo));
    demoReset.hidden = !edited.has(demo.id);
    for (const button of document.querySelectorAll<HTMLButtonElement>(".pick")) {
      button.ariaSelected = String(button.dataset.demo === demo.id);
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>(".pick")) {
    button.addEventListener("click", () => {
      const demo = demos.find((d) => d.id === button.dataset.demo);
      if (!demo || demo === current) return;
      // Keep the edit that is in the box before leaving it behind.
      if (demoPane.read() !== sourceOf(current)) {
        edited.set(current.id, demoPane.read());
      }
      select(demo);
      demoAnalyze();
    });
  }

  demoReset.addEventListener("click", () => {
    edited.delete(current.id);
    demoPane.load(current.source);
    demoReset.hidden = true;
    demoAnalyze();
  });

  // ── the cross-file example: two files, one run ──────────────────────────────

  const xfileOut = document.getElementById("xfile-out") as HTMLPreElement;
  const xfilePanes = new Map<string, Pane>();

  // Every run reports on both files, whichever one was typed in: the bug is
  // the pair, and a file checked alone is the reading this section argues
  // against.
  const xfileAnalyze = runner(xfileOut, () =>
    Object.fromEntries(
      crossFiles.map((file) => [file.path, xfilePanes.get(file.id)!.read()]),
    ),
  );

  const onCrossFileInput = debounced(xfileAnalyze);

  for (const file of crossFiles) {
    const wrap = document.querySelector(
      `[data-xfile="${file.id}"]`,
    ) as HTMLDivElement;
    const reset = document.querySelector(
      `[data-xfile-reset="${file.id}"]`,
    ) as HTMLButtonElement;

    const pane: Pane = mountPane(wrap, () => {
      // Shown on the keystroke, not on the run 400ms later: the button has to
      // answer the edit that put it there.
      reset.hidden = pane.read() === file.source;
      onCrossFileInput();
    });
    xfilePanes.set(file.id, pane);

    reset.addEventListener("click", () => {
      pane.load(file.source);
      reset.hidden = true;
      xfileAnalyze();
    });
  }

  // ── start ───────────────────────────────────────────────────────────────────

  // Instantiate up front, so the first run is as quick as the rest and a failed
  // fetch surfaces here rather than as a box that never fills in.
  initWasm(wasmUrl).then(
    () => {
      demoAnalyze();
      // The cross-file terminal already holds the build-time run of the same
      // sources, so it is left alone until the visitor edits something.
    },
    (error: unknown) => {
      const message = `<span class="red">could not load the analyzer:</span> ${
        error instanceof Error ? error.message : String(error)
      }`;
      demoOut.innerHTML = message;
      demoOut.ariaBusy = "false";
      // The cross-file terminal keeps its build-time output, which is still
      // true; only the re-running stops.
    },
  );
</script>

