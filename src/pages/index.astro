  /* ── two panes and the wire between them ───────────────────────────────── */
  /* Side by side from 1080px: each pane then holds 56 columns of 13px Source
     Code Pro and the longest sample line is 55, so no row wraps and the wire
     cannot move. Stacked, the underline under each name remains as the trace. */
  .pair {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    align-items: stretch;
    position: relative;
  }
  @media (min-width: 1080px) {
    .pair {
      grid-template-columns: minmax(0, 1fr) 72px minmax(0, 1fr);
      gap: 0;
    }
  }
  .pane {
    border: 1px solid var(--hairline-strong);
    min-width: 0;
    background: var(--bg);
    display: flex;
    flex-direction: column;
  }
  .pane-head {
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-inline: var(--code-pad);
    border-bottom: 1px solid var(--hairline);
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
  }
  .pane-head code {
    font-size: 12px;
    color: var(--ink);
  }
  .pane-head .role {
    display: flex;
    gap: 1em;
    overflow: hidden;
  }
  .pane-head .role > span {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .reset {
    font: inherit;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--hairline-strong);
    text-underline-offset: 0.15em;
  }
  .reset:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .gutter {
    display: none;
    position: relative;
  }

  /* The textarea stays in flow so its `rows` still set the height; the
     highlighted copy is laid over that box exactly. */
  .editor-wrap {
    position: relative;
    display: flex;
    flex: 1;
    min-width: 0;
  }
  /*
   * Every declaration here decides where a glyph lands, so the two layers
   * share all of them. Drifting on any one shows up as text sliding out from
   * under the caret.
   */
  .editor,
  .hl {
    margin: 0;
    padding: var(--code-pad);
    border: none;
    border-radius: 0;
    font-family: var(--mono);
    font-size: var(--code-size);
    line-height: var(--lh-code);
    letter-spacing: normal;
    tab-size: 2;
    white-space: pre;
    color: var(--ink);
  }
  .editor {
    flex: 1;
    min-width: 0;
    position: relative;
    z-index: 1;
    resize: none;
    background: transparent;
    /* The script sets `rows` to the line count, so only `wrap="off"` can
       overflow, and only sideways. */
    overflow-x: auto;
    overflow-y: hidden;
  }
  /* Once the layer underneath is painted, the real text gets out of its way
     and only the caret is left. Before that the plain text is what is read. */
  .editor-wrap.lit .editor {
    color: transparent;
    caret-color: var(--ink);
  }
  .editor:focus {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .hl {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: none;
    pointer-events: none;
  }
  /* Two-tone highlighting, like the rest of the page: keywords carry weight,
     comments recede, everything else is ink. The spans are built by the
     script, so they never carry Astro's scope attribute. */
  .hl :global(.tk-k) {
    font-weight: 600;
  }
  .hl :global(.tk-c) {
    color: var(--muted);
    font-style: italic;
  }

  /* The wire. Both marks sit on row 5 of their file, so the y is derived from
     the same numbers as the text: padding, four rows, then just under the
     glyphs. The gutter segment adds the pane's head and borders. Drawn only
     while `.pair` is `.wired`, which the first edit removes. */
  .wire {
    display: none;
  }
  @media (min-width: 1080px) {
    .gutter {
      display: block;
    }
    .pair.wired .wire,
    .pair.wired .wire::before,
    .pair.wired .gutter::before {
      content: "";
      display: block;
      position: absolute;
      border-top: 1.5px solid var(--accent);
      pointer-events: none;
      z-index: 2;
    }
    .pair.wired .wire {
      top: calc(var(--code-pad) + 4 * var(--lh-code) + 20.5px);
    }
    /* `  const [query, setQuery] =`: the name spans 16ch to 24ch, the wire
       runs on from there to the pane's edge. */
    .pair.wired .wire.from {
      left: calc(var(--code-pad) + 16ch);
      right: 0;
    }
    /* `    onChange(...)`: the wire arrives from the edge and stops under the
       name, 4ch to 12ch. */
    .pair.wired .wire.to {
      left: 0;
      right: calc(100% - var(--code-pad) - 12ch);
    }
    .pair.wired .gutter::before {
      left: 0;
      right: 0;
      top: calc(1px + 32px + 1px + var(--code-pad) + 4 * var(--lh-code) + 20.5px);
    }
  }

  /* ── analyzer output ───────────────────────────────────────────────────── */
  .out {
    border-top: 1px solid var(--hairline-strong);
    border-bottom: 1px solid var(--hairline-strong);
    padding: var(--code-pad) 0;
    font-size: var(--code-size);
    line-height: var(--lh-code);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--ink);
    background: var(--bg);
  }
  .out[aria-busy="true"] {
    opacity: 0.6;
  }
  /* The reporter's six SGR codes, mapped by ansi.ts. Only the severity word
     carries the accent; the tick and bold stay ink. */
  .out :global(.b),
  .out :global(.green) {
    font-weight: 600;
  }
  .out :global(.d) {
